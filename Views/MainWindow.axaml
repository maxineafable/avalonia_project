<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaProject.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AvaloniaProject.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="AvaloniaProject"
        Width="600"
        Height="400">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>
    
    <StackPanel>
        <Grid>
            <Button Click="RefreshButton_OnClick"
                    HorizontalAlignment="Left"
                    Margin="5"
                    Content="Refresh" />
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="18"
                       FontWeight="Bold">
                Welcome to Project
            </TextBlock>
        </Grid>

        <Border Margin="5" CornerRadius="10" Background="LightBlue">
            <TextBlock FontSize="14" Margin="5" FontWeight="SemiBold">Add your game</TextBlock>
        </Border>
        <Grid ShowGridLines="False" Margin="5"
              ColumnDefinitions="100, 200"
              RowDefinitions="Auto, Auto"
              >
            <TextBlock Grid.Row="0" Grid.Column="0" Margin="10">Name</TextBlock>
            <TextBox 
                Grid.Row="0" 
                Grid.Column="1" 
                Margin="0 5"
                Name="Name"
            />
            <TextBlock Grid.Row="1" Grid.Column="0" Margin="10">Path</TextBlock>
            <TextBox 
                Grid.Row="1" 
                Grid.Column="1" 
                Margin="0 5"
                Name="Path"
            />
        </Grid>
        <UserControl>
            <UserControl.Styles>
                <Style Selector="Button">
                    <Setter Property="Background" Value="LightBlue"></Setter>
                </Style>
                <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="SkyBlue"></Setter>
                </Style>
            </UserControl.Styles>
            <Button Padding="16, 8" Margin="5, 0" Name="SaveButton" Click="SaveButton_OnClick">Save</Button>
        </UserControl>
        
        <TextBlock Margin="5" Foreground="Black" Name="TextStatus"></TextBlock>
        
        <ListBox ItemsSource="{Binding Games}" Margin="5">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="5" Padding="10">
                        <StackPanel Spacing="5">
                            <TextBlock
                                Text="{Binding Name}"
                                FontSize="18"
                                FontWeight="Bold" />

                            <TextBlock
                                Text="{Binding FormattedPlayTime, StringFormat='Total Playtime: {0}'}"
                                FontSize="12" />
                    
                            <UserControl>
                                <UserControl.Styles>
                                    <Style Selector="Button">
                                        <Setter Property="Background" Value="LightBlue"></Setter>
                                    </Style>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Background" Value="SkyBlue"></Setter>
                                    </Style>
                                </UserControl.Styles>
                                <Button Padding="12, 6" 
                                        Margin="0, 5"
                                        FontSize="12"
                                        Name="PlayButton" 
                                        Tag="{Binding}"
                                        Click="PlayButton_OnClick"
                                        Content="Play"
                                />
                            </UserControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</Window>
